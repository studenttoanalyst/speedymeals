<?xml version="1.0" encoding="utf-8"?>
<!--
  Release / default network security config.

  Cleartext HTTP is NOT permitted anywhere: HTTPS only, for every host.
  This is the config that ships inside the Play AAB — it contains no
  localhost / 10.0.2.2 / 127.0.0.1 exception at all.

  The development host allowlist lives in
  src/debug/res/xml/network_security_config.xml and only applies to
  `flutter run` / debug builds, which merge that source set over this one.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
