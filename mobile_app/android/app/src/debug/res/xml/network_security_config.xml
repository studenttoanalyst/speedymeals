<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network security config (overrides the main one for debug builds).

  Android 9 (API 28+) blocks cleartext HTTP by default, which would stop a
  debug build from reaching the local FastAPI backend over
  `http://10.0.2.2:8000` (the Android emulator's alias for the host machine).

  This permits cleartext ONLY for local development hosts. Release builds use
  src/main/res/xml/network_security_config.xml instead, which blocks cleartext
  everywhere — so these dev hosts never ship in the Play AAB.

  Testing on a PHYSICAL device over the LAN? Add your machine's IP here as
  well, e.g. <domain includeSubdomains="false">192.168.1.20</domain>.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
