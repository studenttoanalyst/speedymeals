# ============================================================
# SpeedyMeals Flutter app
# Keep this file self-contained: it must protect the app folder
# even when it is copied or built outside this repository.
# ============================================================

# ------------------------------------------------------------
# Flutter / Dart build output and generated files
# ------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
app.*.symbols
app.*.map.json
.metadata
.widget_preview/
**/ephemeral/

# ------------------------------------------------------------
# Android
# ------------------------------------------------------------
.gradle/
android/.gradle/
android/local.properties
local.properties
android/kotlin/
captures/
**/GeneratedPluginRegistrant.java
android/app/debug/
android/app/profile/
android/app/release/

# Release signing material — never commit a keystore or its passwords.
*.jks
*.keystore
key.properties

# ------------------------------------------------------------
# iOS / macOS generated files
# ------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Pods/
**/macos/Flutter/ephemeral/

# ------------------------------------------------------------
# Linux / Windows generated files
# ------------------------------------------------------------
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/
**/windows/x64/
**/windows/x86/

# ------------------------------------------------------------
# Environment files and secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
serviceAccountKey.json
GoogleService-Info.plist

# Firebase client config is PUBLIC (project id / API key / sender id only) and
# is required by the Android build. It is deliberately tracked — do not remove
# it and do not add a pattern that ignores it. Backend service-account keys are
# ignored by the repo-root .gitignore.
!android/app/google-services.json

# ------------------------------------------------------------
# Logs, temporary files, OS files
# ------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
tmp/
temp/
*.pid
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# IDE / editor
# ------------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*.swn
