NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Supabase Credentials (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Firebase Cloud Messaging (web push for the restaurant/admin portals).
# Firebase console -> Project settings -> General -> Your apps -> Web app (config)
# and Cloud Messaging -> Web Push certificates (VAPID key). Leave empty to disable push.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Local dev only: feed synthetic orders into the dashboard "orders per hour" charts.
# Requires the gitignored file public/dev-seed/orders.js. Ignored in production builds.
NEXT_PUBLIC_DEV_SEED="false"

# Local dev only: credentials for the "Fill dev credentials" button on /restaurant/login.
# Never set these in production; the button is compiled out of production builds.
NEXT_PUBLIC_DEV_DEMO_EMAIL=""
NEXT_PUBLIC_DEV_DEMO_PASSWORD=""
