{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "SpeedyMeals canonical design tokens. Single source of truth for website/ (CSS variables in app/globals.css) and mobile_app/ (lib/core/theme). Edit here first; see docs/DESIGN_TOKENS.md.",
  "meta": {
    "version": "1.0.0",
    "status": "approved 2026-10-23 — Sharp radius, red.600 CTA"
  },
  "color": {
    "$type": "color",
    "brand": {
      "red": {
        "50":  { "$value": "#FDF0EE", "$description": "Error / CTA tint background" },
        "100": { "$value": "#FBE1DE" },
        "200": { "$value": "#F5C2BC" },
        "300": { "$value": "#EE9A91" },
        "400": { "$value": "#E86A5F" },
        "500": { "$value": "#E23A2E", "$description": "Brand red. Logo, icons, large display (>=24px bold), selection, live dot. NOT a fill behind small white text (4.30:1)." },
        "600": { "$value": "#C92F24", "$description": "CTA fill (white text 5.36:1), red text on light, error" },
        "700": { "$value": "#A8241B", "$description": "CTA hover / pressed (7.16:1)" },
        "800": { "$value": "#861D16" },
        "900": { "$value": "#651611" },
        "950": { "$value": "#3F0D0A" },
        "on-dark": { "$value": "#FF6B5E", "$description": "Red text on ink surfaces (6.43:1)" }
      },
      "blue": {
        "50":  { "$value": "#EAF1FA", "$description": "Info tint background" },
        "100": { "$value": "#D5E3F4" },
        "200": { "$value": "#ABC6E8" },
        "300": { "$value": "#7EA6D9" },
        "400": { "$value": "#4F84C6" },
        "500": { "$value": "#2F6FB8" },
        "600": { "$value": "#1E5FA8", "$description": "Trust: links, info, verified, tracking, focus ring (6.45:1 on white)" },
        "700": { "$value": "#174C88", "$description": "Link hover" },
        "800": { "$value": "#123B6A" },
        "900": { "$value": "#0D2B4D" },
        "on-dark": { "$value": "#6FA0E0", "$description": "Blue on ink surfaces (6.65:1)" }
      },
      "tan": {
        "100": { "$value": "#F3E8D0", "$description": "Premium tint, max one region per screen" },
        "400": { "$value": "#C7A874", "$description": "Decorative only: rules, icon fills, badges on ink (never text on light: 2.26:1)" },
        "700": { "$value": "#8A6A32", "$description": "Tan text on light (5.01:1)" }
      }
    },
    "ink": {
      "50":  { "$value": "#F6F5F3", "$description": "Canvas / subtle fill (paper-off)" },
      "100": { "$value": "#EFEEEB", "$description": "Skeleton, disabled fill, hover fill" },
      "200": { "$value": "#E4E2DD", "$description": "Hairline divider / card border (line)" },
      "300": { "$value": "#CFCCC6", "$description": "Strong divider, secondary-button border" },
      "400": { "$value": "#A0A4AB", "$description": "Disabled text, decorative icons. Not for meaningful text on light." },
      "500": { "$value": "#6E727A", "$description": "Placeholder on white only (4.83:1)" },
      "600": { "$value": "#5B5F66", "$description": "Secondary / meta text (6.42:1 white, 5.89:1 ink-50)" },
      "700": { "$value": "#373C46", "$description": "Strong secondary text, labels" },
      "800": { "$value": "#25282F", "$description": "Raised surface on dark" },
      "850": { "$value": "#1A1D23", "$description": "Dark section surface" },
      "900": { "$value": "#15171A", "$description": "Primary text; inverse surface" },
      "950": { "$value": "#0D0E10" }
    },
    "green": {
      "50":  { "$value": "#E8F5EE" }, "100": { "$value": "#D1EBDD" }, "200": { "$value": "#A8D8BE" },
      "300": { "$value": "#74BF98" }, "400": { "$value": "#3FA172" }, "500": { "$value": "#16905F" },
      "600": { "$value": "#0E7A50" }, "700": { "$value": "#0B6542" }, "800": { "$value": "#094F34" },
      "900": { "$value": "#073B27" }
    },
    "amber": {
      "50":  { "$value": "#FDF4E3" }, "100": { "$value": "#FBE8C4" }, "200": { "$value": "#F6D08A" },
      "300": { "$value": "#F0B550" }, "400": { "$value": "#F5A623" }, "500": { "$value": "#F59E0B" },
      "600": { "$value": "#C27803" }, "700": { "$value": "#9A5B00" }, "800": { "$value": "#7A4800" },
      "900": { "$value": "#5C3600" }
    },
    "paper": { "$value": "#FFFFFF" },
    "border": {
      "control": { "$value": "#8C877E", "$description": "Input / checkbox boundary (3.57:1, meets WCAG 1.4.11)" }
    },
    "semantic": {
      "success":    { "$value": "{color.green.600}", "$description": "#0E7A50 — 5.36:1 on white; white text on it OK" },
      "success-bg": { "$value": "{color.green.50}" },
      "warning":    { "$value": "{color.amber.700}", "$description": "#9A5B00 — 5.43:1 on white" },
      "warning-bg": { "$value": "{color.amber.50}" },
      "rating":     { "$value": "{color.amber.500}", "$description": "Star icon fill only (ink text on it 8.36:1)" },
      "error":      { "$value": "{color.brand.red.600}" },
      "error-bg":   { "$value": "{color.brand.red.50}" },
      "info":       { "$value": "{color.brand.blue.600}" },
      "info-bg":    { "$value": "{color.brand.blue.50}" }
    },
    "role": {
      "background":      { "$value": "{color.paper}" },
      "canvas":          { "$value": "{color.ink.50}" },
      "surface":         { "$value": "{color.paper}" },
      "surface-inverse": { "$value": "{color.ink.900}" },
      "text":            { "$value": "{color.ink.900}" },
      "text-secondary":  { "$value": "{color.ink.600}" },
      "text-disabled":   { "$value": "{color.ink.400}" },
      "text-inverse":    { "$value": "{color.paper}" },
      "text-inverse-secondary": { "$value": "#CBD0D8", "$description": "11.59:1 on ink-900" },
      "line":            { "$value": "{color.ink.200}" },
      "cta":             { "$value": "{color.brand.red.600}" },
      "cta-hover":       { "$value": "{color.brand.red.700}" },
      "on-cta":          { "$value": "{color.paper}" },
      "link":            { "$value": "{color.brand.blue.600}" },
      "focus":           { "$value": "{color.brand.blue.600}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans":    { "$value": ["Figtree", "system-ui", "sans-serif"], "$description": "All UI text, both platforms" },
      "display": { "$value": ["Archivo Black", "sans-serif"], "$description": "Marketing hero + mobile splash/confirmation only" },
      "mono":    { "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "Order IDs, codes, ETAs, eyebrow labels" }
    },
    "minSize": { "$type": "dimension", "$value": "11px" }
  },
  "typography": {
    "$type": "typography",
    "display-xl":  { "$value": { "fontFamily": "{font.family.display}", "fontSize": "56px", "fontWeight": 400, "lineHeight": 0.95, "letterSpacing": "-0.035em" }, "$description": "Web marketing hero only; clamp down to display-lg on small screens" },
    "display-lg":  { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "32px", "fontWeight": 800, "lineHeight": 1.25, "letterSpacing": "-0.02em" } },
    "display-md":  { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "26px", "fontWeight": 700, "lineHeight": 1.3, "letterSpacing": "-0.015em" } },
    "headline-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "22px", "fontWeight": 700, "lineHeight": 1.27, "letterSpacing": "-0.01em" } },
    "headline-md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "18px", "fontWeight": 600, "lineHeight": 1.33, "letterSpacing": "-0.005em" } },
    "headline-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "fontWeight": 600, "lineHeight": 1.375, "letterSpacing": "0" } },
    "body-lg":     { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" } },
    "body-md":     { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.43, "letterSpacing": "0" } },
    "body-sm":     { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.33, "letterSpacing": "0.01em" } },
    "label-lg":    { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "fontWeight": 600, "lineHeight": 1.43, "letterSpacing": "0.01em" } },
    "label-md":    { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px", "fontWeight": 600, "lineHeight": 1.33, "letterSpacing": "0.02em" } },
    "label-sm":    { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "fontWeight": 700, "lineHeight": 1.27, "letterSpacing": "0.03em" } },
    "eyebrow":     { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "11px", "fontWeight": 500, "lineHeight": 1.27, "letterSpacing": "0.06em" }, "$description": "Uppercase section labels" },
    "price":       { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "18px", "fontWeight": 800, "lineHeight": 1.22, "letterSpacing": "-0.01em" } }
  },
  "radius": {
    "$type": "dimension",
    "$description": "'Sharp' policy (confirmed) — nothing between 8px and pill.",
    "none": { "$value": "0px",    "$description": "Full-bleed media, hero banners, tables, page sections" },
    "xs":   { "$value": "2px",    "$description": "Status badges/tags, checkboxes, progress bars" },
    "sm":   { "$value": "4px",    "$description": "Buttons, inputs, selects, chips, segmented controls, tooltips" },
    "md":   { "$value": "6px",    "$description": "Cards, menus/popovers, toasts, thumbnails" },
    "lg":   { "$value": "8px",    "$description": "Dialogs, bottom sheets (top corners), promo cards" },
    "full": { "$value": "9999px", "$description": "Avatars, switches, status dots, unread-count badges, floating nav pill (scoped exception). FABs use sm." }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" }, "0.5": { "$value": "2px" }, "1": { "$value": "4px" }, "2": { "$value": "8px" },
    "3": { "$value": "12px" }, "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" },
    "8": { "$value": "32px" }, "10": { "$value": "40px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" }, "20": { "$value": "80px" },
    "layout": {
      "screen-edge-mobile": { "$value": "16px" },
      "gutter-web-sm": { "$value": "16px" }, "gutter-web-md": { "$value": "24px" }, "gutter-web-lg": { "$value": "32px" },
      "card-padding": { "$value": "16px" }, "card-padding-compact": { "$value": "12px" },
      "card-gap": { "$value": "12px" },
      "section-gap-mobile": { "$value": "24px" }, "section-gap-web": { "$value": "64px" },
      "bottom-nav-clearance": { "$value": "88px" }
    }
  },
  "size": {
    "$type": "dimension",
    "touch-min": { "$value": "44px" },
    "control-sm": { "$value": "32px", "$description": "Web dashboards (pointer) only" },
    "control-md": { "$value": "40px", "$description": "Web default" },
    "control-lg": { "$value": "48px", "$description": "Mobile default; web primary CTA on marketing" },
    "icon-sm": { "$value": "16px" }, "icon-md": { "$value": "20px" }, "icon-lg": { "$value": "24px" },
    "focus-ring": { "$value": "2px" }, "focus-offset": { "$value": "2px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Borders carry structure; shadows only signal lift. Tint = ink-900 (21,23,26).",
    "0": { "$value": "none" },
    "1": { "$value": "0 1px 2px 0 rgba(21,23,26,0.06)", "$description": "Resting card (always with 1px line border)" },
    "2": { "$value": "0 4px 12px -2px rgba(21,23,26,0.10)", "$description": "Menus, popovers, sticky bars" },
    "3": { "$value": "0 12px 32px -8px rgba(21,23,26,0.18)", "$description": "Dialogs, bottom sheets, floating cart" }
  },
  "motion": {
    "press-scale": { "$type": "number", "$value": 0.97 },
    "duration": {
      "$type": "duration",
      "instant": { "$value": "80ms" }, "fast": { "$value": "120ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "300ms" }
    },
    "easing": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0, 0, 1] } }
  }
}
