# Database
DATABASE_URL=postgresql://username:password@localhost:5432/speedymeals

# JWT Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Redis (OTP store, rate limit, rider live location)
REDIS_URL=redis://localhost:6379/0

# AWS S3 (rider docs: CNIC, license, vehicle photo)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=speedymeals-docs

# Google Maps (Distance Matrix API - delivery fee calc)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
