# Database
DATABASE_URL=postgresql://username:password@localhost:5432/speedymeals

# JWT Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Redis (OTP store, rate limit, rider live location)
REDIS_URL=redis://localhost:6379/0

# AWS S3 (rider docs: CNIC, license, vehicle photo)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=speedymeals-docs

# Google Maps (Distance Matrix API - delivery fee calc)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# SMS / OTP (see docs/decisions/ADR-001-otp-sms-provider.md)
# console = OTP printed to server log only, no real SMS sent, zero cost (dev/test default)
# production = real provider wired in once chosen post-MVP
SMS_PROVIDER_MODE=console
SMS_API_KEY=

# First Admin Auto-Seed (see docs/decisions/ADR-002-first-admin-seed.md)
# Used once on startup to create the first admin row if none exists yet. Change after first run.
FIRST_ADMIN_EMAIL=admin@speedymeals.com
FIRST_ADMIN_PASSWORD=change-this-before-first-run
